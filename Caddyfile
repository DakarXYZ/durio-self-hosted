# dur.io reverse proxy.
#
# Machine-specific parts are generated by scripts/generate_config.sh (not in git):
#   config/caddy/global.caddy — ACME email, trusted proxies (--behind-proxy), lan tweaks
#   config/caddy/site.caddy   — TLS mode (tls internal for lan, shortlived profile for ip) and HSTS
# The site address comes from CADDY_SITE in .env ($STOAT_DOMAIN, or :80 behind another proxy).
{
	import /etc/caddy/durio/global.caddy
}

(security) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Every reverse_proxy: the Axum services (autumn, january, gifbox) read the client IP from
# CF-Connecting-IP when [api.security] trust_cloudflare = true (Revolt.overrides.toml).
# Caddy always overwrites the header, so clients cannot spoof it while no service is
# published around Caddy.
(upstream) {
	header_up CF-Connecting-IP {client_ip}
}

{$CADDY_SITE} {
	import /etc/caddy/durio/site.caddy
	import security

	# Server discovery: clients enter only the address of the server.
	handle /.well-known/stoat {
		header Access-Control-Allow-Origin *
		header Cache-Control "public, max-age=300"
		root * /srv/discovery
		rewrite * /stoat.json
		file_server
	}

	# Android App Links (optional): config/well-known/assetlinks.json, 404 when absent.
	handle /.well-known/assetlinks.json {
		root * /srv/well-known
		rewrite * /assetlinks.json
		file_server
	}

	# Invite links (the standard ones of Stoat), https://<domain>/invite/<code>, opened in a
	# browser: one static page for every code, invite.js reads the code from the address (the
	# only static page with scripts, all same-origin). The same code signs up on the invite-only
	# server; "Open in the browser" leads to /web/app/invite/<code>.
	handle /invite/* {
		root * /srv/site
		rewrite * /invite.html
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'"
		header X-Frame-Options DENY
		header Cache-Control "no-store"
		header X-Robots-Tag noindex
		encode zstd gzip
		file_server
	}

	# LiveKit webhooks reach voice-ingress inside the docker network only.
	handle /ingress* {
		respond 404
	}

	handle_path /api* {
		encode zstd gzip
		reverse_proxy api:14702 {
			import upstream
			header_down Location "^/" "/api/"
		}
	}

	# Exact match is intended: the query string does not take part in matching.
	handle_path /ws {
		reverse_proxy events:14703 {
			import upstream
			# do not drop every socket at once on `caddy reload`
			stream_close_delay 5m
		}
	}

	# Media is already compressed: no encode here. No request_body limit either: autumn
	# enforces body_limit_size itself (MAX_FILE_SIZE_MB + 5 MB, scripts/generate_config.sh).
	handle_path /autumn* {
		header X-Frame-Options DENY
		reverse_proxy autumn:14704 {
			import upstream
			header_down Location "^/" "/autumn/"
		}
	}

	handle_path /january* {
		reverse_proxy january:14705 {
			import upstream
			header_down Location "^/" "/january/"
		}
	}

	handle_path /gifbox* {
		reverse_proxy gifbox:14706 {
			import upstream
			header_down Location "^/" "/gifbox/"
		}
	}

	handle_path /livekit* {
		reverse_proxy livekit:7880 {
			import upstream
			stream_close_delay 5m
			header_down Location "^/" "/livekit/"
		}
	}

	# No page of its own at /: everyone starts from the instructions.
	handle / {
		redir * /web/info 302
	}

	# How to connect: browser, apps, invites, E2EE, sources. Static, no scripts.
	handle /web/info {
		root * /srv/site
		rewrite * /info.html
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'"
		header X-Frame-Options DENY
		encode zstd gzip
		file_server
	}

	handle /web/app {
		redir * /web/app/ 308
	}

	# Browser client: the web service serves it under the same path (no stripping), with the SPA
	# fallback and the cache headers (index.html no-cache, hashed assets immutable). The CSP is
	# ours: scripts and workers only from this origin (+ WebAssembly), connections (API, WebSocket,
	# LiveKit) over TLS, no framing of the client.
	handle /web/app/* {
		encode zstd gzip
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' https: wss: blob: data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Frame-Options DENY
			Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
			# after the response from web: replace, never duplicate, what the image might set
			defer
		}
		reverse_proxy web:8080 {
			import upstream
		}
	}

	# Static files of the pages above (/e2ee.html, /e2ee-en.html, /style.css, /invite.js, ...);
	# the apps link to https://<domain>/e2ee.html. Other paths: 404.
	handle {
		root * /srv/site
		header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'self'"
		header X-Frame-Options DENY
		encode zstd gzip
		file_server
	}
}
