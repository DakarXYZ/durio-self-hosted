# secrets.env is generated by scripts/generate_config.sh (0600, append-only) — do not copy this file.
# This list documents what it contains. Values are single-quoted; multi-line values use double
# quotes with \n. Keep an encrypted copy off the server: age -r <key> secrets.env > secrets.env.age
#
# Files (autumn): losing this key makes EVERY stored file unreadable; it cannot be rotated.
REVOLT__FILES__ENCRYPTION_KEY='<openssl rand -base64 32>'
# Web push (unused without a browser client; generated so public defaults are never used)
REVOLT__PUSHD__VAPID__PRIVATE_KEY='<generated>'
REVOLT__PUSHD__VAPID__PUBLIC_KEY='<generated>'
# LiveKit API key/secret (also passed to LiveKit as LIVEKIT_KEYS)
REVOLT__API__LIVEKIT__NODES__WORLDWIDE__KEY='<hex 12>'
REVOLT__API__LIVEKIT__NODES__WORLDWIDE__SECRET='<hex 48>'
# RabbitMQ (applied to the container only while data/rabbit is empty)
REVOLT__RABBIT__USERNAME='durio'
REVOLT__RABBIT__PASSWORD='<hex 48>'
# MinIO root login (createbuckets, backups, migrate-storage)
MINIO_ROOT_USER='durio-<hex>'
MINIO_ROOT_PASSWORD='<hex 48>'
# Mongo: root (admin/backups), application user, replica-set keyFile, backend URI
MONGO_ROOT_PASSWORD='<hex 48>'
MONGO_REVOLT_PASSWORD='<hex 48>'
MONGO_KEYFILE='<hex 512>'
REVOLT__DATABASE__MONGODB='mongodb://revolt:<MONGO_REVOLT_PASSWORD>@database:27017/revolt?authSource=admin&replicaSet=rs0'
REVOLT__DATABASE__REDIS='redis://redis/'
# Files bucket: MinIO service account of autumn (minio) or the provider's keys (s3)
REVOLT__FILES__S3__ACCESS_KEY_ID='<generated or S3_ACCESS_KEY_ID>'
REVOLT__FILES__S3__SECRET_ACCESS_KEY='<generated or S3_SECRET_ACCESS_KEY>'
# DuckDNS updater (only with the `duckdns` profile; from env DUCKDNS_TOKEN)
DUCKDNS_TOKEN='<token>'
# Push via FCM (scripts/generate_config.sh --fcm-json service-account.json)
# REVOLT__PUSHD__FCM__KEY_TYPE='service_account'
# REVOLT__PUSHD__FCM__PROJECT_ID=...  PRIVATE_KEY_ID, CLIENT_EMAIL, CLIENT_ID, AUTH_URI, TOKEN_URI,
# AUTH_PROVIDER_X509_CERT_URL, CLIENT_X509_CERT_URL
# REVOLT__PUSHD__FCM__PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional
# REVOLT__API__SMTP__PASSWORD='<smtp password>'   (host/username/from_address go to Revolt.overrides.toml)
# REVOLT__API__SECURITY__TENOR_KEY='<key>'         (gifbox profile)
